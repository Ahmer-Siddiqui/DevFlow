# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend URL (for CORS and email redirect links)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Supabase or Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow

# Redis Configuration (Cache, BullMQ, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Provider: 'local' | 'supabase'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Supabase Storage (Only required if STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=devflow-attachments

# Logging
LOG_LEVEL=debug
